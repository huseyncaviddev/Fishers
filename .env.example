# Fishers Website Environment Variables
# Copy this file to .env.local and fill in the values

# Site URL (used for sitemap, OpenGraph and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.united-fishers.com

# Social profiles. Facebook uses the address below by default; set it to override.
# Other networks appear only when configured. These addresses are public.
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/ABB.informasiya
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/<handle>
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/company/<company>

# Contact form (optional - for future integration)
# The contact form and newsletter currently hand off to the visitor's own mail
# client via mailto:, so no server credentials are required to run the site.
# CONTACT_FORM_EMAIL=info@fishers.az
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
