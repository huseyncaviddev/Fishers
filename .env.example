# Fishers Website Environment Variables
# Copy this file to .env.local and fill in the values

# Site URL (used for sitemap and OpenGraph)
NEXT_PUBLIC_SITE_URL=https://fishers.az

# Contact form (optional - for future integration)
# CONTACT_FORM_EMAIL=info@fishers.az
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
