{
  "name": "fishers-website",
  "version": "1.0.0",
  "private": true,
  "description": "Premium aquaculture website for Fishers — built with Next.js 16, React 19, Tailwind CSS 4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:media": "node tests/media-lifecycle.spec.mjs",
    "test:hero": "node tests/hero-carousel.spec.mjs",
    "test:responsive": "node tests/responsive.spec.mjs",
    "test:controls": "node tests/controls.spec.mjs",
    "test:perf": "node tests/perf-mobile.mjs",
    "test:e2e": "npm run test:media && npm run test:hero && npm run test:responsive && npm run test:controls",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "geist": "^1.7.2",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
